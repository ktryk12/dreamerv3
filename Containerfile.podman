# CPU-first DreamerV3 image for Podman.
#
# The upstream Dockerfile builds on the NVIDIA driver image and installs DMLab,
# MineRL, Atari, ProcGen and dm_control. That is heavy and GPU-bound. This
# Containerfile stays deliberately small: CPU JAX plus Crafter, which is enough
# to smoke test the agent and to iterate on our own environments. The upstream
# Dockerfile is kept untouched for GPU runs.
#
#   podman build -f Containerfile.podman -t dreamerv3-cpu .
#   podman run --rm -v dreamerv3-logs:/logdir dreamerv3-cpu \
#     python dreamerv3/main.py --logdir /logdir/run --configs crafter debug

# Pinned by digest, not tag: the tag moved between 2026-10-14 and
# 2026-10-23, and a moving base defeats the point of the lock below.
# Refresh deliberately, together with scripts/lock-deps.sh.
FROM docker.io/library/python:3.11-slim@sha256:b7a9e5f6a93d6d4a31f129bbd4bdee69efccb6ded0fb230d78aafaf37af98377

# System libraries. ffmpeg for video logging, libgl1/libglib2.0 for the
# OpenCV wheel that Crafter pulls in, git for pip installs from source.
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg git libgl1 libglib2.0-0 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_ROOT_USER_ACTION=ignore

RUN pip install -U pip setuptools

# Every runtime dependency comes from the lock, with wheel hashes, so a rebuild
# installs the same 101 packages rather than whatever is newest.
# --require-hashes also makes pip refuse any requirement that is not listed,
# which is what turns "pinned" into "complete".
#
# Upstream's requirements.txt is still the input to the lock, so bumps from
# danijar/dreamerv3 keep reaching us -- as a reviewable diff from
# scripts/lock-deps.sh instead of silently at build time. The lock owns the
# four lines the CPU build handles specially: jax[cuda12] and
# nvidia-cuda-nvcc are dropped, and jax/chex/optax are held at the 0.4.33 line
# because newer chex/optax require jax >= 0.7, which rejects the positional
# jax.jit arguments in embodied/jax/transform.py. crafter, our benchmark
# environment, is pinned there too.
COPY requirements.lock.txt requirements.lock.txt
RUN pip install --require-hashes --no-deps -r requirements.lock.txt

WORKDIR /app
COPY . .

# No xvfb and no nvidia-smi here, unlike upstream's entrypoint.sh: Crafter
# renders offscreen with no X server, so commands run directly.
ENV JAX_PLATFORMS=cpu
CMD ["python", "-c", "import dreamerv3; print('dreamerv3 image ready')"]
